# Copy to .env and fill in. Never commit .env.
APP_ENV=development
FRONTEND_ORIGIN=http://localhost:3000
# Hosts that cut long connections (Vercel: 300 s): switch to a fresh connection at a quiet moment
# after this many seconds (Vercel: 240). 0 = never (servers, docker-compose.prod.yml).
SESSION_ROTATE_S=0

# Providers (swappable by config) - all free tiers
# STT_PROVIDER: assemblyai | deepgram        LLM_PROVIDER: groq | openai_compatible
STT_PROVIDER=assemblyai
LLM_PROVIDER=groq
EMBEDDING_PROVIDER=local
VECTOR_PROVIDER=pinecone

# AssemblyAI: assemblyai.com/dashboard (free signup credit)
ASSEMBLYAI_API_KEY=
# Groq: console.groq.com (free tier, no card)
GROQ_API_KEY=
GROQ_ANSWER_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=openai/gpt-oss-20b
GROQ_REASONING_EFFORT=low
# Deepgram (STT_PROVIDER=deepgram): console.deepgram.com (free signup credit, no card)
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
# Any OpenAI-compatible API (LLM_PROVIDER=openai_compatible). Examples:
#   OpenRouter free models: LLM_BASE_URL=https://openrouter.ai/api/v1, LLM_API_KEY from openrouter.ai/keys,
#     LLM_ANSWER_MODEL / LLM_FAST_MODEL = a model id ending in ":free" (list: openrouter.ai/models?q=free)
#   Ollama on this machine (free, no key): LLM_BASE_URL=http://localhost:11434/v1, LLM_ANSWER_MODEL=llama3.2
#   Groq through this provider: LLM_BASE_URL=https://api.groq.com/openai/v1 with your Groq key
LLM_BASE_URL=
LLM_API_KEY=
LLM_ANSWER_MODEL=
LLM_FAST_MODEL=
LLM_REASONING_EFFORT=
LLM_JSON_MODE=true
LLM_SERVICE_NAME=
# Local embeddings, no key needed
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Pinecone: app.pinecone.io (free Starter plan)
PINECONE_API_KEY=
PINECONE_INDEX=interview-copilot
# Free Starter plan only allows aws / us-east-1
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Local database and Redis (docker-compose.prod.yml sets its own)
DATABASE_URL=postgresql://copilot:copilot@localhost:5432/copilot
# Redis holds state shared by all backend instances (sign-in limits, live-session tickets).
# Required outside development; in development the app falls back to memory if Redis is down.
REDIS_URL=redis://localhost:6379/0

# Auth: JWT_SECRET signs sign-in tokens (32+ random characters; required outside development).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=
ACCESS_TOKEN_DAYS=7
# Same value as INTERNAL_API_SECRET in frontend/.env.local
INTERNAL_API_SECRET=
# Comma-separated emails that can open the answer-speed report (/admin/latency)
ADMIN_EMAILS=

# Stripe (test mode is free). Without STRIPE_SECRET_KEY the app runs and paid plans show as not available.
# STRIPE_SECRET_KEY: Developers > API keys (sk_test_... / sk_live_...)
# STRIPE_WEBHOOK_SECRET: Developers > Webhooks > your endpoint > Signing secret (whsec_...).
#   Endpoint URL: https://<backend>/api/billing/webhook. Events: checkout.session.completed,
#   customer.subscription.created, customer.subscription.updated, customer.subscription.deleted
# STRIPE_PRICE_*: Product catalog > the plan's monthly price > Price ID (price_...)
# Local testing without Stripe: set STRIPE_WEBHOOK_SECRET=whsec_local_test, STRIPE_PRICE_PRO=price_local_pro,
#   STRIPE_PRICE_PREMIUM=price_local_premium, then run: python -m scripts.stripe_event --help
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_PREMIUM=
# Only for tests against stripe-mock; leave empty
STRIPE_API_BASE=

# ---------- Production deployment (docker-compose.prod.yml) ----------
# Not needed for local development. On the server, `deploy/configure.sh <domain>` fills these in
# (addresses plus new random secrets). See DEPLOY.md.
# Public addresses: with real domain names, Caddy gets HTTPS certificates automatically.
APP_ADDRESS=
API_ADDRESS=
PUBLIC_APP_URL=
PUBLIC_API_URL=
# Database password (used only inside the server; set once, before the first start)
POSTGRES_PASSWORD=
# Frontend sign-in secrets (the same values as in frontend/.env.local for local runs)
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
