NEXT_PUBLIC_API_URL=http://localhost:8000

# Auth.js (NextAuth). NEXTAUTH_SECRET: any random 32+ character string (encrypts the session cookie).
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
# Backend address as seen from the Next.js server
BACKEND_URL=http://localhost:8000
# Must equal INTERNAL_API_SECRET in the backend .env (used only for the Google sign-in hand-off)
INTERNAL_API_SECRET=
# Optional: "Continue with Google" appears only when both are set
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
